{
  "expo": {
    "name": "Scopone",
    "slug": "scopone",
    "version": "1.0.0",
    "scheme": "scopone",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alessiobertollo.scopone"
    },
    "android": {
      "package": "com.alessiobertollo.scopone",
      "adaptiveIcon": {
        "backgroundColor": "#1B5E3F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f74df05d-8726-47e2-a52a-2d4b14731b5b"
      }
    },
    "owner": "alessiobertollos-team"
  }
}
